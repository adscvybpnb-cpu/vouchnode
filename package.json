{
  "name": "vouchnode-marketplace",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "pnpm --parallel --filter !@vouchnode/shared dev",
    "build": "pnpm --filter @vouchnode/backend exec prisma generate && pnpm --filter @vouchnode/backend build",
    "start": "pnpm --filter @vouchnode/backend start",
    "test": "pnpm --recursive test",
    "db:migrate": "pnpm --filter @vouchnode/backend db:migrate",
    "db:seed": "pnpm --filter @vouchnode/backend db:seed"
  },
  "engines": {
    "node": ">=20.19.0",
    "pnpm": ">=9.0.0"
  },
  "pnpm": {
    "auditConfig": {
      "ignoreCves": ["*"]
    }
  },
  "devDependencies": {
    "pm2": "^7.0.4"
  }
}
