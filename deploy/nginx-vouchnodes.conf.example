server {
    listen 80;
    server_name vouchnodes.com www.vouchnodes.com;
    return 301 https://$host$request_uri;
}

server {
    listen 80;
    server_name api.vouchnodes.com;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    server_name vouchnodes.com www.vouchnodes.com;

    ssl_certificate /etc/letsencrypt/live/vouchnodes.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/vouchnodes.com/privkey.pem;

    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}

server {
    listen 443 ssl;
    server_name api.vouchnodes.com;

    ssl_certificate /etc/letsencrypt/live/api.vouchnodes.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/api.vouchnodes.com/privkey.pem;

    client_max_body_size 50m;

    location / {
        proxy_pass http://127.0.0.1:4000;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 75s;
    }
}
