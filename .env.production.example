# Deployment reference only: do not copy placeholders into the production host.
# Store actual values in the host's secret manager or a root-owned systemd
# EnvironmentFile. Use the same protected file for the API and worker services.

# --- Public service addresses ---
NODE_ENV=production
APP_NAME=VouchNode
APP_URL=https://vouchnodes.com
API_URL=https://api.vouchnodes.com
API_PORT=4000
API_HOST=127.0.0.1
API_VERSION=v1
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_URL=
TELEGRAM_WEBHOOK_SECRET=
FRONTEND_URL=https://vouchnodes.com
NEXT_PUBLIC_APP_URL=https://vouchnodes.com
NEXT_PUBLIC_API_URL=https://api.vouchnodes.com/api/v1
NEXT_PUBLIC_WS_URL=https://api.vouchnodes.com
# Used only by Next.js server-side rendering; keep this on the local host.
INTERNAL_API_URL=http://127.0.0.1:4000/api/v1

# --- External PostgreSQL (provider-issued connection string; TLS required) ---
# URL-encode reserved characters in the username/password.
DATABASE_URL=
# Per-process Prisma limits; total pools across API/worker instances must fit the DB cap.
PRISMA_CONNECTION_LIMIT=5
PRISMA_POOL_TIMEOUT=20
PRISMA_CONNECT_TIMEOUT=10

# --- Redis ---
# Use a TLS Redis URL (rediss://) for managed Redis.
# For loopback Redis on the AlexHost VPS, use redis:// with a strong password,
# Redis bound to 127.0.0.1, and firewall access restricted to the application.
# URL-encode reserved characters in username/password.
REDIS_URL=

# --- Required independent secrets ---
# Generate distinct values; do not reuse between environments or purposes.
# Example generation: openssl rand -hex 48 (JWT/admin) and openssl rand -hex 32 (encryption).
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d
ADMIN_TOKEN_SECRET=
ADMIN_USERNAME=
ADMIN_PASSWORD=
ADMIN_EMAIL=
ENCRYPTION_KEY=

# --- Cloud object storage (S3-compatible) ---
STORAGE_PROVIDER=s3
S3_ENDPOINT=
S3_BUCKET=
S3_KYC_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=
S3_PUBLIC_URL=
# Keep S3_KYC_BUCKET private. Limit the key to required operations/buckets.

# --- Native on-chain payments ---
# Checkout uses the native chain scanner. NowPayments IPN is optional and
# external-only; leave the signing secret unset unless callbacks are configured.
CRYPTO_PROVIDER=nowpayments
NOWPAYMENTS_API_KEY=
NOWPAYMENTS_IPN_SECRET=
ENABLE_TEST_PAYMENT_SIMULATION=false

# --- Production rate limits ---
RATE_LIMIT_MAX=300
RATE_LIMIT_SELLER_MAX=500
RATE_LIMIT_WINDOW_MS=60000
AUTH_RATE_LIMIT_MAX=10
AUTH_RATE_LIMIT_WINDOW_MS=900000
