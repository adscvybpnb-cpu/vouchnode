# ===========================================
# VouchNode - Environment Variables
# ===========================================

# --- App ---
NODE_ENV=development
APP_NAME=VouchNode
APP_URL=http://localhost:3000
API_URL=http://127.0.0.1:4000
API_PORT=4000
API_HOST=127.0.0.1
API_VERSION=v1
FRONTEND_URL=http://localhost:3000

# --- Local Docker Compose credentials (replace before starting containers) ---
POSTGRES_DB=vouchnode
POSTGRES_USER=vouchnode
POSTGRES_PASSWORD=REPLACE_WITH_A_STRONG_RANDOM_PASSWORD
REDIS_PASSWORD=REPLACE_WITH_A_DIFFERENT_STRONG_RANDOM_PASSWORD

# --- Database ---
DATABASE_URL=postgresql://vouchnode:REPLACE_WITH_A_STRONG_RANDOM_PASSWORD@localhost:5433/vouchnode?schema=public

# --- Redis ---
REDIS_URL=redis://:REPLACE_WITH_A_DIFFERENT_STRONG_RANDOM_PASSWORD@localhost:6379

# --- JWT ---
JWT_ACCESS_SECRET=your-super-secret-access-key-min-32-chars
JWT_REFRESH_SECRET=your-super-secret-refresh-key-min-32-chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# --- Encryption (for sensitive data at rest) ---
ENCRYPTION_KEY=your-32-byte-hex-encryption-key-here

# --- Email (SMTP) ---
EMAIL_PROVIDER=smtp
TELEGRAM_BOT_TOKEN=
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SITE_SENDER_NAME=VouchNode
SITE_SENDER_EMAIL=Mopphu1@gmail.com
EMAIL_FROM_NAME=VouchNode
EMAIL_FROM_ADDRESS=noreply@vouchnode.com

# --- SMS ---
SMS_PROVIDER=twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# --- Storage ---
STORAGE_PROVIDER=local
STORAGE_LOCAL_PATH=./uploads
# S3-compatible (set STORAGE_PROVIDER=s3)
S3_ENDPOINT=
S3_BUCKET=
S3_KYC_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=us-east-1
S3_PUBLIC_URL=

# --- Crypto Payments ---
CRYPTO_PROVIDER=nowpayments
NOWPAYMENTS_API_KEY=
# Optional when using native on-chain payments only. Configure this to enable NowPayments IPN callbacks.
NOWPAYMENTS_IPN_SECRET=
COINGATE_API_KEY=
# Each private RPC variable accepts one URL or a comma-separated ordered fallback pool.
PRIVATE_RPC_ARB=
PRIVATE_RPC_ETH=
PRIVATE_RPC_BSC=
PRIVATE_RPC_BASE=
PRIVATE_RPC_POLYGON=
PRIVATE_RPC_OP=
PRIVATE_RPC_SOL=
PRIVATE_RPC_LTC=
PRIVATE_RPC_BTC=
PRIVATE_RPC_BCH=
PRIVATE_RPC_TRON=


# --- Rate Limiting ---
RATE_LIMIT_MAX=1500
RATE_LIMIT_SELLER_MAX=2000
RATE_LIMIT_WINDOW_MS=60000
ENABLE_TEST_PAYMENT_SIMULATION=false
TEST_PAYMENT_SIMULATION_SECRET=
AUTH_RATE_LIMIT_MAX=10
AUTH_RATE_LIMIT_WINDOW_MS=900000

# --- Security ---
MAX_FAILED_LOGIN_ATTEMPTS=5
ACCOUNT_LOCK_DURATION_MINUTES=30
OTP_EXPIRY_MINUTES=10
OTP_LENGTH=6

# --- Business Rules (all configurable, not hardcoded) ---
SELLER_RESPONSE_PERIOD_HOURS=96
BUYER_CONFIRMATION_PERIOD_HOURS=96
DISPUTE_PERIOD_HOURS=96
ORDER_PAYMENT_TIMEOUT_HOURS=24
PLATFORM_FEE_PERCENT=2.5
SELLER_FEE_PERCENT=0
WITHDRAWAL_MIN_AMOUNT=10
WITHDRAWAL_MAX_AMOUNT=10000
DEPOSIT_MIN_AMOUNT=5
WITHDRAWAL_FEE_FIXED=0
WITHDRAWAL_FEE_PERCENT=1

# --- File Uploads ---
MAX_FILE_SIZE_MB=10
ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/webp,image/gif
ALLOWED_DOCUMENT_TYPES=application/pdf
